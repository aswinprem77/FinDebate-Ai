# Backend
APP_NAME=StockDebate.AI
APP_ENV=local
API_V1_PREFIX=/api/v1
JWT_SECRET=change-me-before-deploy
JWT_EXPIRES_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/stockdebate
REDIS_URL=redis://localhost:6379/0
EVIDENCE_CACHE_TTL_SECONDS=900
FREE_DEBATES_PER_HOUR=5
FREE_DEBATES_PER_DAY=20
PRO_DEBATES_PER_HOUR=30
PRO_WARNING_THRESHOLD_PER_HOUR=25
MODEL_TIMEOUT_SECONDS=25

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
